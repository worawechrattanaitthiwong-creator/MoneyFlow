{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moneyflow",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/receipts/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moneyflow-db",
      "database_id": "603b51f3-85f7-47a4-98e5-6804641002ab",
      "migrations_dir": "migrations"
    }
  ]
}
